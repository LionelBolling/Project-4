extends "res://tests/first_person_check.gd"

func wait_for_lesson(next: int, limit: int) -> void:
	for i in range(limit):
		if game.tutorial_step == next: return
		await tick(1)
	check(false, "Lesson did not advance to " + str(next) + " at " + str(game.player.position))

func run() -> void:
	game = load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	game.set_physics_process(false)
	game.muted = true
	game.ambience.stop()
	game.set_lids(0)
	game.bedroom.hide()
	game.shadow.show()
	# All seven lessons must pass with real movement and input, in order.
	game.enter_lesson(0)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	await wait_for_lesson(1, 150)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	await tick(12)
	key(KEY_SPACE, true)
	await tick(1)
	key(KEY_SPACE, false)
	await wait_for_lesson(2, 130)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	await tick(12)
	key(KEY_SPACE, true)
	await wait_for_lesson(3, 180)
	key(KEY_SPACE, false)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	key(KEY_SHIFT, true)
	await wait_for_lesson(4, 150)
	key(KEY_SHIFT, false)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	for i in range(150):
		if -game.player.position.z > 36: break
		await tick(1)
	key(KEY_SPACE, true)
	await tick(1)
	key(KEY_SPACE, false)
	await wait_for_lesson(5, 140)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	await settle()
	key(KEY_W, true)
	await tick(10)
	key(KEY_SPACE, true)
	await tick(1)
	key(KEY_SPACE, false)
	await tick(18)
	key(KEY_SHIFT, true)
	for i in range(100):
		if game.tutorial_progress > 0: break
		await tick(1)
	check(game.tutorial_progress > 0, "Dive landing must fracture the practice platform")
	key(KEY_SHIFT, false)
	await tick(17)
	key(KEY_SPACE, true)
	await tick(1)
	key(KEY_SPACE, false)
	await wait_for_lesson(6, 160)
	key(KEY_W, false)
	game.begin_lesson_attempt()
	key(game.qte_key, true)
	check(game.state == "countdown", "Tutorial must unlock race only after final success")
	check(game.completed_lessons.size() == 7, "Every lesson must complete through gameplay")
	check(game.elapsed == 0 and game.ghost_distance == 0, "Practice cannot advance race or rival")
	print("TUTORIAL PLAYTHROUGH: ", failures, " failures / completed ", game.completed_lessons)
	quit(1 if failures else 0)
